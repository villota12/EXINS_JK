rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health / connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & auth info (Staff and Owner accounts)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Categories masterlist (Prevent legacy dummy seeding)
    match /categories/{categoryId} {
      allow read, delete: if true;
      allow create, update: if !(categoryId in ['cat-jackets', 'cat-shoes', 'cat-caps', 'cat-tees', 'cat-pants', 'cat-hoodies']);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Bales
    match /bales/{baleId} {
      allow read, write: if true;
    }

    // Products (Showcase & Inventory)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders (POS and Customer showcase orders)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Finance - Expense Accounts (Prevent legacy dummy seeding)
    match /expenseAccounts/{accountId} {
      allow read, delete: if true;
      allow create, update: if !(accountId in ['acc-bales', 'acc-rent', 'acc-utilities', 'acc-staff', 'acc-packaging', 'acc-courier']);
    }

    // Finance - Operating Expenses
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Finance - Cashflow Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
